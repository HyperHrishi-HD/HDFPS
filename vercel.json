{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/web/index.html" },
    { "source": "/index.html", "destination": "/web/index.html" },
    { "source": "/game.js", "destination": "/web/game.js" },
    { "source": "/style.css", "destination": "/web/style.css" },
    { "source": "/favicon.svg", "destination": "/web/favicon.svg" },
    { "source": "/robots.txt", "destination": "/web/robots.txt" },
    { "source": "/vendor/:path*", "destination": "/web/vendor/:path*" }
  ],
  "headers": [
    {
      "source": "/vendor/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
